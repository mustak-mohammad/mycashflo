# myCashflo — Web App Environment Variables
# Copy this file to .env and fill in values for your environment.

# API base URL.
# Leave empty in development to use the Vite dev proxy (/api → localhost:3000).
# Set to full URL in production, e.g. https://api.mycashflo.com/api
VITE_API_URL=

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

