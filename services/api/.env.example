# ─── myCashflo API Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Web app origin allowed for CORS (the Vite dev server URL)
WEB_ORIGIN=http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# Local example: postgresql://postgres:secret@localhost:5432/mycashflo
# Cloud example (Neon free tier): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/mycashflo?sslmode=require
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/mycashflo

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── LiveKit (Phase 5) ────────────────────────────────────────────────────────
# Sign up at https://cloud.livekit.io (free tier available)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── AI Provider (Phase 5) ───────────────────────────────────────────────────
# Supported: openai | groq | deepgram (configure in voice-agent service)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to true ONLY after proper consent, compliance, and operator approval
ENABLE_OUTBOUND_CALLS=false

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
