# ─── myCashflo API Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Web app origin allowed for CORS (the Vite dev server URL)
WEB_ORIGIN=http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# Local example: postgresql://postgres:secret@localhost:5432/mycashflo
# Cloud example (Neon free tier): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/mycashflo?sslmode=require
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/mycashflo

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── LiveKit (Phase 5 & Real-Time Voice) ──────────────────────────────────────
# Sign up at https://cloud.livekit.io (free tier available)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=chotu-voice-agent
LIVEKIT_WEBHOOK_SECRET=your_livekit_webhook_secret
# LiveKit dispatch simulation is strictly forbidden in production and disabled by default in dev
ALLOW_DEV_LIVEKIT_SIMULATION=false

# ─── Call Recording (LiveKit Egress) ─────────────────────────────────────────
# Object path prefix used for recorded audio files.
LIVEKIT_EGRESS_PATH=recordings
# Optional S3-compatible storage target. If LIVEKIT_EGRESS_S3_BUCKET is empty,
# LiveKit Cloud's project default storage is used instead.
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=false

# ─── SIP Telephony & Carrier Trunking (LiveKit SIP) ───────────────────────────
# Outbound & Inbound SIP trunking configuration via LiveKit Cloud SIP service.
# Connects LiveKit rooms to PSTN carriers (e.g. Twilio Elastic SIP, Telnyx, Tata, Airtel).
SIP_PROVIDER_NAME=LIVEKIT_SIP
SIP_OUTBOUND_TRUNK_ID=ST_placeholder_outbound_trunk_id
SIP_INBOUND_TRUNK_ID=ST_placeholder_inbound_trunk_id
SIP_OUTBOUND_CALLER_ID=+918000000000
SIP_CARRIER_HOST=sip.carrier.pstn.example.com
SIP_USERNAME=placeholder_sip_username
SIP_PASSWORD=placeholder_sip_password
# Telephony Webhook Verification Secrets (fail-closed if missing in production)
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token
EXOTEL_WEBHOOK_TOKEN=placeholder_exotel_webhook_token
TELEPHONY_WEBHOOK_SECRET=placeholder_telephony_webhook_secret
TELEPHONY_WEBHOOK_BASE_URL=

# ─── AI Provider (Phase 5) ───────────────────────────────────────────────────
# Supported: openai | groq | deepgram (configure in voice-agent service)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key

# ─── Transactional Email (Resend) ───────────────────────────────────────────
# Sign up at https://resend.com (free tier available)
# Keep EMAIL_DELIVERY_ENABLED=false for safe local development / simulation mode
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=myCashflo <onboarding@resend.dev>
# When EMAIL_DELIVERY_ENABLED=true in non-production, delivery is strictly restricted
# to this test recipient (or @resend.dev test domain) to prevent contacting real customers.
EMAIL_TEST_RECIPIENT=delivered@resend.dev
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Set to true ONLY after proper consent, compliance, and operator approval
ENABLE_OUTBOUND_CALLS=false
# Global feature flag for automated payment reminders through Chotu AI
AUTOMATED_REMINDERS_ENABLED=false
# Narrowly scoped safety flag: allows single test-reminders to send live to EMAIL_TEST_RECIPIENT without enabling global EMAIL_DELIVERY_ENABLED
REMINDERS_TEST_EMAIL_DELIVERY_ENABLED=false
# Test-only reminder activation: allows scheduled reminders to run strictly gated to allowlisted test recipients without enabling broad customer delivery
REMINDERS_TEST_MODE=false

# ─── Google OAuth 2.0 (Sign Up / Sign In) ──────────────────────────────────
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Mock Google auth is strictly forbidden in production and disabled by default in dev
ALLOW_DEV_MOCK_AUTH=false

# ─── Payment Gateways (Razorpay & Stripe) ──────────────────────────────────
# Default mode requires valid credentials. Simulation mode allowed ONLY in development
# when PAYMENT_SIMULATION_MODE=true or requested per-call with simulate=true.
# Set PAYMENT_SIMULATION_MODE=false for production/live operations.
PAYMENT_SIMULATION_MODE=false

# ─── Integration Secret Encryption Key (AES-256-GCM) ─────────────────────────
# Required to encrypt/decrypt tenant integration secrets at rest (must NEVER be stored in PostgreSQL).
# Generate a 32-byte hex key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# Razorpay (Primary India Payment Gateway)
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Stripe (International Payment Gateway)
# Obtain from Stripe Dashboard -> Developers -> API keys & Webhooks
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug


