// myCashflo — Full Prisma Schema (Phase 2)
// Run after filling in DATABASE_URL in .env:
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenant (Company) ─────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  customers                Customer[]
  invoices                 Invoice[]
  payments                 Payment[]
  collectionCases          CollectionCase[]
  followUpTasks            FollowUpTask[]
  callSessions             CallSession[]
  notifications            Notification[]
  integrationCfgs          IntegrationConfig[]
  auditLogs                AuditLog[]
  actionProposals          ActionProposal[]
  voicePrompts             VoicePrompt[]
  documentDeliveryRequests DocumentDeliveryRequest[]
  deliveryAttempts         DeliveryAttempt[]
  paymentRefunds           PaymentRefund[]
  paymentOrderIntents      PaymentOrderIntent[]
  notificationOutbox       NotificationOutbox[]
}

// ── Users ─────────────────────────────────────────────────────────────────────
model User {
  id               String    @id @default(cuid())
  email            String
  passwordHash     String
  name             String
  role             UserRole  @default(AGENT)
  isActive         Boolean   @default(true)
  tenantId         String
  tokensValidAfter DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collectionCases CollectionCase[]
  followUpTasks   FollowUpTask[]
  callSessions    CallSession[]
  auditLogs       AuditLog[]
  createdPrompts  VoicePrompt[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
}

// ── Refresh Tokens ─────────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Customers ─────────────────────────────────────────────────────────────────
model Customer {
  id                 String         @id @default(cuid())
  name               String
  email              String
  phone              String
  company            String?
  gstNumber          String?
  billingAddress     String?
  outstandingBalance Decimal        @default(0) @db.Decimal(19, 4)
  currency           String         @default("INR")
  status             CustomerStatus @default(ACTIVE)
  notes              String?
  tenantId           String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // ── Communication Consent & Channel Preferences (Phase 1C) ───────────────
  emailConsent       ConsentState @default(UNKNOWN)
  emailConsentAt     DateTime?
  emailConsentSource String?

  whatsappConsent       ConsentState @default(UNKNOWN)
  whatsappConsentAt     DateTime?
  whatsappConsentSource String?

  smsConsent       ConsentState @default(UNKNOWN)
  smsConsentAt     DateTime?
  smsConsentSource String?

  voiceConsent       ConsentState @default(UNKNOWN)
  voiceConsentAt     DateTime?
  voiceConsentSource String?

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices                 Invoice[]
  payments                 Payment[]
  collectionCases          CollectionCase[]
  notifications            Notification[]
  callSessions             CallSession[]
  documentDeliveryRequests DocumentDeliveryRequest[]
  paymentRefunds           PaymentRefund[]
  paymentOrderIntents      PaymentOrderIntent[]
  notificationOutbox       NotificationOutbox[]

  @@index([tenantId])
  @@index([tenantId, status])
}

enum ConsentState {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// ── Invoices ──────────────────────────────────────────────────────────────────
model Invoice {
  id          String        @id @default(cuid())
  number      String
  customerId  String
  amount      Decimal       @db.Decimal(19, 4)
  outstanding Decimal       @default(0) @db.Decimal(19, 4)
  currency    String        @default("INR")
  status      InvoiceStatus @default(DRAFT)
  description String?
  issueDate   DateTime
  dueDate     DateTime
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                 Customer                  @relation(fields: [customerId], references: [id])
  payments                 Payment[]
  collectionCases          CollectionCase[]
  paymentPromises          PaymentPromise[]
  documentDeliveryRequests DocumentDeliveryRequest[]
  paymentRefunds           PaymentRefund[]
  paymentOrderIntents      PaymentOrderIntent[]
  notificationOutbox       NotificationOutbox[]

  @@unique([number, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([dueDate])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// ── Payments ──────────────────────────────────────────────────────────────────
model Payment {
  id          String        @id @default(cuid())
  ref         String        @unique
  customerId  String
  invoiceId   String
  amount      Decimal       @db.Decimal(19, 4)
  currency    String        @default("INR")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String? // External payment provider reference
  paidAt      DateTime?
  notes       String?
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer             @relation(fields: [customerId], references: [id])
  invoice            Invoice              @relation(fields: [invoiceId], references: [id])
  refunds            PaymentRefund[]
  notificationOutbox NotificationOutbox[]

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([providerRef])
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model PaymentRefund {
  id                String       @id @default(cuid())
  tenantId          String
  paymentId         String
  invoiceId         String
  customerId        String
  provider          String       @default("RAZORPAY")
  providerRefundId  String       @unique
  providerPaymentId String
  amount            Decimal      @db.Decimal(19, 4)
  currency          String       @default("INR")
  status            RefundStatus @default(PENDING)
  reason            String?
  rawEvent          String?
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([providerPaymentId])
}

enum OrderIntentStatus {
  CREATING
  CREATED
  COMPLETED
  FAILED
  EXPIRED
}

model PaymentOrderIntent {
  id              String            @id @default(cuid())
  tenantId        String
  invoiceId       String
  customerId      String
  idempotencyKey  String            @unique
  activeClaimKey  String?           @unique
  receipt         String            @unique
  amount          Decimal           @db.Decimal(19, 4)
  amountInPaise   Int
  currency        String            @default("INR")
  status          OrderIntentStatus @default(CREATING)
  provider        String            @default("RAZORPAY")
  providerOrderId String?           @unique
  paymentId       String?           @unique
  keyId           String?
  isSimulated     Boolean           @default(false)
  errorMessage    String?
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, invoiceId, status])
  @@index([expiresAt])
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  CARD
  PAYMENT_LINK
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ── Collection Cases ──────────────────────────────────────────────────────────
model CollectionCase {
  id         String       @id @default(cuid())
  customerId String
  invoiceId  String?
  assignedTo String? // User.id of the assigned agent
  priority   CasePriority @default(MEDIUM)
  status     CaseStatus   @default(OPEN)
  notes      String?
  resolvedAt DateTime?
  tenantId   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id])
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  assignedAgent   User?            @relation(fields: [assignedTo], references: [id])
  followUpTasks   FollowUpTask[]
  paymentPromises PaymentPromise[]
  callSessions    CallSession[]

  @@index([tenantId])
  @@index([customerId])
  @@index([assignedTo])
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ── Follow-Up Tasks ───────────────────────────────────────────────────────────
model FollowUpTask {
  id               String       @id @default(cuid())
  collectionCaseId String?
  customerId       String?
  assignedTo       String?
  title            String
  description      String?
  dueDate          DateTime
  priority         CasePriority @default(MEDIUM)
  done             Boolean      @default(false)
  completedAt      DateTime?
  tenantId         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collectionCase CollectionCase? @relation(fields: [collectionCaseId], references: [id])
  assignedAgent  User?           @relation(fields: [assignedTo], references: [id])

  @@index([tenantId])
  @@index([assignedTo])
  @@index([dueDate])
}

// ── Call Sessions (Chotu AI) ──────────────────────────────────────────────────
model CallSession {
  id                String           @id @default(cuid())
  collectionCaseId  String?
  customerId        String?
  userId            String // agent who initiated
  livekitRoom       String?
  duration          Int? // seconds
  outcome           CallOutcome?
  transcript        String?          @db.Text
  summary           String?          @db.Text
  stage             String? // Current or final conversation stage
  metadata          Json? // Structured extraction data (PTP amount, date, method, etc.)
  recordingUrl      String? // URL of the call audio recording (LiveKit egress output)
  recordingStatus   RecordingStatus? // Lifecycle of the recording
  recordingEgressId String? // LiveKit egress job id used to resolve the recording
  startedAt         DateTime         @default(now())
  endedAt           DateTime?
  tenantId          String
  createdAt         DateTime         @default(now())

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                 Customer?                 @relation(fields: [customerId], references: [id])
  agent                    User                      @relation(fields: [userId], references: [id])
  collectionCase           CollectionCase?           @relation(fields: [collectionCaseId], references: [id])
  documentDeliveryRequests DocumentDeliveryRequest[]

  @@index([tenantId])
  @@index([customerId])
  @@index([userId])
}

enum CallOutcome {
  PROMISE_TO_PAY
  DISPUTE
  NO_CONTACT
  CALLBACK_REQUESTED
  RESOLVED
  OTHER
  WILL_PAY_LATER
  UNABLE_TO_PAY
  PAYMENT_CLAIMED
}

enum RecordingStatus {
  RECORDING
  PROCESSING
  AVAILABLE
  FAILED
}

// ── Payment Promises ──────────────────────────────────────────────────────────
model PaymentPromise {
  id               String        @id @default(cuid())
  invoiceId        String
  collectionCaseId String?
  promisedAmount   Decimal       @db.Decimal(19, 4)
  promisedDate     DateTime
  status           PromiseStatus @default(PENDING)
  notes            String?
  tenantId         String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  collectionCase CollectionCase? @relation(fields: [collectionCaseId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
}

enum PromiseStatus {
  PENDING
  KEPT
  BROKEN
  PARTIAL
}

// ── Notifications ─────────────────────────────────────────────────────────────
model Notification {
  id         String              @id @default(cuid())
  customerId String
  channel    NotificationChannel
  template   String
  payload    Json?
  status     NotifStatus         @default(QUEUED)
  sentAt     DateTime?
  failReason String?
  tenantId   String
  createdAt  DateTime            @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id])
  notificationOutbox NotificationOutbox?

  @@index([tenantId])
  @@index([customerId])
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotifStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

// ── Durable Notification Outbox (Phase 2D) ─────────────────────────────────
model NotificationOutbox {
  id             String              @id @default(cuid())
  tenantId       String
  customerId     String
  invoiceId      String?
  paymentId      String?
  notificationId String?             @unique
  jobType        OutboxJobType       @default(REMINDER)
  channel        NotificationChannel
  template       String
  stage          ReminderStage?
  idempotencyKey String

  // Lifecycle & State Machine
  status            OutboxJobStatus @default(PENDING)
  scheduledFor      DateTime        @default(now())
  claimedAt         DateTime?
  claimedBy         String?
  leaseToken        String?
  leaseExpiresAt    DateTime?
  lastHeartbeatAt   DateTime?
  dispatchStartedAt DateTime?

  // Differentiated Attempt Accounting
  claimCount          Int       @default(0)
  consecutiveFailures Int       @default(0)
  deliveryAttempts    Int       @default(0)
  maxAttempts         Int       @default(3)
  nextRetryAt         DateTime?

  // Payload, Metadata & Provider Correlation
  payload              Json?
  lastError            String?
  provider             String?
  providerMessageId    String?
  sentAt               DateTime?
  completedAt          DateTime?
  reconciledAt         DateTime?
  reconciliationSource String?
  requeuedAt           DateTime?
  requeuedBy           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Key Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  // Invariants & Indexes
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([status, scheduledFor])
  @@index([leaseExpiresAt])
  @@index([nextRetryAt])
}

enum OutboxJobStatus {
  PENDING
  CLAIMED
  DISPATCHING
  RETRY_WAIT
  COMPLETED
  FAILED
  SUPPRESSED
  UNCERTAIN
  DEAD_LETTER
}

enum OutboxJobType {
  REMINDER
  PAYMENT_RECEIPT
  CUSTOM_NOTIFICATION
}

enum ReminderStage {
  DUE_SOON
  DUE_TODAY
  OVERDUE_STAGE_1
  OVERDUE_STAGE_2
  OVERDUE_STAGE_3
}

// ── Integration Config ────────────────────────────────────────────────────────
model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String // e.g. 'razorpay', 'twilio', 'whatsapp_business'
  config    Json // Encrypted at application layer before storing
  isActive  Boolean  @default(false)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, tenantId])
  @@index([tenantId])
}

// ── Audit Log ─────────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String // e.g. 'customer.created', 'invoice.updated'
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  tenantId   String
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}

// ── Action Proposals (AI Confirmation Workflow) ──────────────────────────────
model ActionProposal {
  id              String         @id @default(cuid())
  actionType      String // e.g. 'record_payment_promise', 'dispute_invoice', 'send_notification'
  toolName        String
  parameters      Json
  summary         String
  riskLevel       ActionRisk     @default(MEDIUM)
  status          ProposalStatus @default(PENDING) // PENDING, APPROVED, REJECTED, EXECUTED
  rejectionReason String?
  result          Json?
  expiresAt       DateTime?
  executedAt      DateTime?
  proposedBy      String // e.g. 'CHOTU_AI' or userId
  reviewedBy      String?
  tenantId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

enum ActionRisk {
  LOW
  MEDIUM
  HIGH
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

// ── Saved Voice Prompts ───────────────────────────────────────────────────────
model VoicePrompt {
  id          String   @id @default(cuid())
  name        String
  description String?
  promptText  String   @db.Text
  category    String   @default("COLLECTIONS") // COLLECTIONS, OVERDUE, DISPUTE, COURTESY, LEGAL
  language    String   @default("en-IN")
  isActive    Boolean  @default(true)
  tenantId    String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User?  @relation(fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
}

// ── Customer Document & Payment Link Delivery ─────────────────────────────────
enum DocumentRequestType {
  INVOICE
  PAYMENT_LINK
  BOTH
}

enum DeliveryChannelPreference {
  WHATSAPP
  EMAIL
  WHATSAPP_AND_EMAIL
}

enum DocumentDeliveryStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

enum DeliveryAttemptChannel {
  WHATSAPP
  EMAIL
}

enum DeliveryAttemptStatus {
  PENDING
  SIMULATED
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model DocumentDeliveryRequest {
  id              String                    @id @default(cuid())
  tenantId        String
  customerId      String
  invoiceId       String
  callSessionId   String?
  requestType     DocumentRequestType       @default(BOTH)
  deliveryChannel DeliveryChannelPreference @default(WHATSAPP_AND_EMAIL)
  status          DocumentDeliveryStatus    @default(PENDING)
  requestedBy     String // 'CHOTU_VOICE', 'MANUAL_AGENT', 'CUSTOMER'
  idempotencyKey  String?                   @unique
  metadata        Json? // Stores payment link URL, token, invoice details, cancellation reasons
  requestedAt     DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id])
  invoice     Invoice           @relation(fields: [invoiceId], references: [id])
  callSession CallSession?      @relation(fields: [callSessionId], references: [id])
  attempts    DeliveryAttempt[]

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([callSessionId])
  @@index([status])
  @@index([createdAt])
}

model DeliveryAttempt {
  id                String                 @id @default(cuid())
  tenantId          String
  requestId         String
  channel           DeliveryAttemptChannel // WHATSAPP or EMAIL
  destinationMasked String // e.g. "+91 98****3210" or "c****r@domain.com"
  status            DeliveryAttemptStatus  @default(PENDING)
  provider          String // 'WHATSAPP_CLOUD', 'RESEND', 'SIMULATED'
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request DocumentDeliveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requestId])
  @@index([status])
  @@index([channel])
}

// ── Shared Webhook Replay Protection (Multi-Instance Safe) ────────────────────
model WebhookReplay {
  id        String   @id @default(cuid())
  provider  String
  replayKey String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
